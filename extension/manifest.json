{
  "manifest_version": 3,
  "name": "PopGuard",
  "version": "1.0.0",
  "description": "Behavior-based deceptive popup and click-hijack guard",
  "browser_specific_settings": {
    "gecko": {
      "id": "popguard@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "dist/background/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ]
}