{
  "manifest_version": 3,
  "name": "PopGuard",
  "version": "1.0.0",
  "description": "Behavior-based deceptive popup and click-hijack guard",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ]
}
